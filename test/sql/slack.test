# name: test/sql/slack.test
# description: SQL-level tests for the slack worker, run through DuckDB by ci/run-integration.sh
# group: [slack]
#
# Runs against test/mock_api/server.py (an offline Slack mock that also answers
# the first request for every URL with 429 + Retry-After, so every query below
# exercises the retry path).

require vgi

require-env SLACK_WORKER

require-env SLACK_MOCK_API

# ------------------------------------------------------------------ attach options

# Without a token the catalog still attaches (so it can be explored), but every
# Slack call explains how to pass one.
statement ok
ATTACH 'slack' AS slack_noauth (TYPE vgi, LOCATION '{SLACK_WORKER}', api_url '{SLACK_MOCK_API}');

statement error
SELECT * FROM slack_noauth.main.auth_info();
----
<REGEX>:.*No Slack token.*

statement ok
DETACH slack_noauth;

# A wrong token is rejected by Slack with invalid_auth.
statement ok
ATTACH 'slack' AS slack_bad (TYPE vgi, LOCATION '{SLACK_WORKER}', token 'xoxb-wrong', api_url '{SLACK_MOCK_API}');

statement error
SELECT * FROM slack_bad.main.channels();
----
<REGEX>:.*invalid_auth.*

statement ok
DETACH slack_bad;


statement ok
ATTACH 'slack' (TYPE vgi, LOCATION '{SLACK_WORKER}', token 'xoxb-test-token', api_url '{SLACK_MOCK_API}');

# The token is declared secret, so DuckDB redacts it.
query T
SELECT options['token'] FROM duckdb_databases() WHERE database_name = 'slack';
----
<redacted>

# ------------------------------------------------------------------- auth_info

query TTTT
SELECT team_id, team, user_id, bot_id FROM slack.main.auth_info();
----
T0MOCK	Mock Team	U0BOT	B0BOT

# -------------------------------------------------------------------- channels

query TTTTI
SELECT id, name, is_private, is_member, num_members FROM slack.main.channels() ORDER BY id;
----
C0GENERAL	general	false	true	4
C0RANDOM	random	false	true	3
G0SECRET	secret	true	true	2

query I
SELECT count(*) FROM slack.main.channels(exclude_archived := false);
----
4

query T
SELECT name FROM slack.main.channels(types := 'private_channel');
----
secret

query I
SELECT epoch(created_at)::BIGINT FROM slack.main.channels() WHERE name = 'general';
----
1767139200

statement error
SELECT * FROM slack.main.channels(types := 'bogus');
----
<REGEX>:.*

# ----------------------------------------------------------------------- users

query TTT
SELECT id, real_name, tz FROM slack.main.users() ORDER BY id;
----
U0ADA	Ada Lovelace	Europe/London
U0BOT	Duck Bot	America/Los_Angeles
U0GRACE	Grace Hopper	America/New_York

query TT
SELECT id, deleted FROM slack.main.users(include_deleted := true) WHERE deleted;
----
U0GONE	true

query TT
SELECT display_name, email FROM slack.main.users() WHERE id = 'U0ADA';
----
ada	ada@example.com

# -------------------------------------------------------------------- messages

# A channel can be given as '#name', 'name' or its ID.
query IIT
SELECT count(*), count(DISTINCT ts), min(text) FROM slack.main.messages('#general');
----
25	25	message 00

query I
SELECT count(*) FROM slack.main.messages('general');
----
25

query I
SELECT count(*) FROM slack.main.messages('C0GENERAL');
----
25

# Newest first, ts parsed to a timestamp.
query TTI
SELECT ts, text, epoch_us(posted_at) FROM slack.main.messages('#general') LIMIT 1;
----
1767227040.000100	message 24	1767227040000100

# Server-side time bounds.
query I
SELECT count(*) FROM slack.main.messages('#general', oldest := TIMESTAMPTZ '2026-01-01 00:10:00+00');
----
15

query I
SELECT count(*) FROM slack.main.messages('#general',
  oldest := TIMESTAMPTZ '2026-01-01 00:10:00+00', latest := TIMESTAMPTZ '2026-01-01 00:14:00+00');
----
4

# Bounds are microsecond-exact: the 00:14 message's ts is 00:14:00.000100.
query I
SELECT count(*) FROM slack.main.messages('#general',
  oldest := TIMESTAMPTZ '2026-01-01 00:10:00+00', latest := TIMESTAMPTZ '2026-01-01 00:14:00.0001+00');
----
5

query TTI
SELECT text, thread_ts, reply_count FROM slack.main.messages('#general') WHERE reply_count > 0;
----
message 05	1767225900.000100	2

query TI
SELECT text, epoch(edited_at)::BIGINT FROM slack.main.messages('#general') WHERE edited_at IS NOT NULL;
----
message 07	1767226050

# Join to users for author names.
query TI
SELECT u.real_name, count(*) AS n
FROM slack.main.messages('#general') m JOIN slack.main.users() u ON u.id = m.user_id
GROUP BY ALL ORDER BY n DESC;
----
Ada Lovelace	16
Grace Hopper	9

query I
SELECT count(*) FROM slack.main.messages('#random');
----
0

statement error
SELECT * FROM slack.main.messages('#does-not-exist');
----
<REGEX>:.*not found.*

statement error
SELECT * FROM slack.main.messages('C0OLD');
----
<REGEX>:.*not_in_channel.*

# --------------------------------------------------------------------- replies

query TT
SELECT user_id, text FROM slack.main.replies('#general', '1767225900.000100') ORDER BY ts;
----
U0ADA	message 05
U0GRACE	reply one
U0ADA	reply two

statement error
SELECT * FROM slack.main.replies('#general', 'not-a-ts');
----
<REGEX>:.*

# ---------------------------------------------------------------- post_message

query TT
SELECT channel_id, text FROM slack.main.post_message('#random', 'hello from duckdb');
----
C0RANDOM	hello from duckdb

# The post landed exactly once and reads back.
query TTT
SELECT user_id, bot_id, text FROM slack.main.messages('#random');
----
U0BOT	B0BOT	hello from duckdb

# Reply in a thread: the reply carries thread_ts and stays out of the history.
query TT
SELECT thread_ts, text FROM slack.main.post_message('C0RANDOM', 'in thread', thread_ts := '1767225900.000100');
----
1767225900.000100	in thread

query I
SELECT count(*) FROM slack.main.messages('#random');
----
1

statement error
SELECT * FROM slack.main.post_message('#random', '');
----
<REGEX>:.*text must not be NULL or empty.*

statement error
SELECT * FROM slack.main.post_message('#nowhere', 'hi');
----
<REGEX>:.*channel_not_found.*

# --------------------------------------------------------------- post_messages

query IT
SELECT count(*), string_agg(text, ',' ORDER BY text)
FROM slack.main.post_messages((SELECT '#random' AS channel, 'bulk ' || i AS text FROM range(3) t(i)));
----
3	bulk 0,bulk 1,bulk 2

query I
SELECT count(*) FROM slack.main.messages('#random');
----
4

# Optional thread_ts column.
query T
SELECT thread_ts FROM slack.main.post_messages((SELECT 'C0GENERAL' AS channel, 'r' AS text, '1767225900.000100' AS thread_ts));
----
1767225900.000100

# Empty input posts nothing.
query I
SELECT count(*) FROM slack.main.post_messages((SELECT '#random' AS channel, 'x' AS text WHERE false));
----
0

statement error
SELECT * FROM slack.main.post_messages((SELECT '#random' AS channel));
----
<REGEX>:.*channel.*text.*

statement error
SELECT * FROM slack.main.post_messages((SELECT '#random' AS channel, NULL::VARCHAR AS text));
----
<REGEX>:.*text must not be NULL or empty.*

# More than one input batch (DuckDB sends 2048 rows per batch): every row posts once.
# Thread replies, so the channel history stays unchanged.
query II
SELECT count(*), count(DISTINCT ts)
FROM slack.main.post_messages((SELECT 'G0SECRET' AS channel, 'row ' || i AS text, '1767225600.000001' AS thread_ts FROM range(5000) t(i)));
----
5000	5000
